{
  "name": "ascendi-dcm-desktop",
  "productName": "AscendI DICOM",
  "version": "0.16.1",
  "private": true,
  "description": "Desktop app for the AscendI DICOM CLI Agent — echo, inventory, send, receive, worklist, tags, edit, de-identify and DICOMweb (STOW/QIDO/WADO), with a live transfer report.",
  "author": "AscendI",
  "license": "MIT",
  "repository": "https://github.com/Alan6195/dcm-cli-agent",
  "main": "main.js",
  "scripts": {
    "copy-engine": "node copy-engine.js",
    "prestart": "node copy-engine.js",
    "start": "electron .",
    "predist": "node copy-engine.js",
    "dist": "electron-builder",
    "predist:win": "node copy-engine.js",
    "dist:win": "electron-builder --win",
    "predist:mac": "node copy-engine.js",
    "dist:mac": "electron-builder --mac",
    "prepack": "node copy-engine.js",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "dcmjs": "^0.50.3",
    "dcmjs-codecs": "^0.0.8",
    "dcmjs-dimse": "^0.3.3",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "//appId": [
    "build.appId below is deliberately still com.asteris.dcm.desktop, and the",
    "AscendI rename did not touch it. appId is the application identity Windows",
    "and NSIS match on to decide whether an installer upgrades what is already",
    "there or installs a second, unrelated program. Change it and every existing",
    "install stops seeing updates, the new one lands beside it, and each user has",
    "to find and uninstall the old app by hand. Keeping it makes the rename",
    "arrive as an ordinary update: same app, new name.",
    "Retiring the old identifier is a separate, deliberate clean break — it needs",
    "a migration plan for installed copies, not a one-line edit here.",
    "(This lives outside the build object on purpose: electron-builder validates",
    "build with additionalProperties:false, so a comment key inside it would fail",
    "the build. npm ignores top-level keys beginning with //.)"
  ],
  "build": {
    "appId": "com.asteris.dcm.desktop",
    "productName": "AscendI DICOM",
    "copyright": "Copyright © AscendI",
    "publish": [
      {
        "provider": "github",
        "owner": "Alan6195",
        "repo": "dcm-cli-agent"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/dcmjs-codecs/build/*.wasm"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!test/**",
      "!engine/test/**",
      "!engine/tools/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "./ad-hoc-sign-mac.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AscendI-DICOM-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AscendI DICOM"
    },
    "portable": {
      "artifactName": "AscendI-DICOM-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "artifactName": "AscendI-DICOM-${version}-${arch}.${ext}"
    }
  }
}
