{
  "name": "asteris-dcm-desktop",
  "productName": "Asteris DICOM App",
  "version": "0.13.0",
  "private": true,
  "description": "Desktop app for the Asteris DICOM CLI Agent — echo, inventory, send, receive, worklist, tags, edit, de-identify and DICOMweb (STOW/QIDO/WADO), with a live transfer report.",
  "author": "Asteris",
  "license": "MIT",
  "repository": "https://github.com/Alan6195/dcm-cli-agent",
  "main": "main.js",
  "scripts": {
    "copy-engine": "node copy-engine.js",
    "prestart": "node copy-engine.js",
    "start": "electron .",
    "predist": "node copy-engine.js",
    "dist": "electron-builder",
    "predist:win": "node copy-engine.js",
    "dist:win": "electron-builder --win",
    "predist:mac": "node copy-engine.js",
    "dist:mac": "electron-builder --mac",
    "prepack": "node copy-engine.js",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "dcmjs": "^0.50.3",
    "dcmjs-codecs": "^0.0.8",
    "dcmjs-dimse": "^0.3.3",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.asteris.dcm.desktop",
    "productName": "Asteris DICOM App",
    "copyright": "Copyright © Asteris",
    "publish": [
      {
        "provider": "github",
        "owner": "Alan6195",
        "repo": "dcm-cli-agent"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/dcmjs-codecs/build/*.wasm"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "engine/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!test/**",
      "!engine/test/**",
      "!engine/tools/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Asteris-DICOM-App-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Asteris DICOM App"
    },
    "portable": {
      "artifactName": "Asteris-DICOM-App-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "artifactName": "Asteris-DICOM-App-${version}-${arch}.${ext}"
    }
  }
}
