{
  "name": "dcm-cli-agent",
  "version": "0.12.0",
  "description": "A single-binary DICOM CLI for folders of DICOM files: C-ECHO, C-STORE, C-FIND, a permissive receiver, tag inspection and editing, inventory and de-identification.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/cli.js",
  "bin": {
    "dcm": "bin/dcm.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alan6195/dcm-cli-agent.git"
  },
  "homepage": "https://github.com/Alan6195/dcm-cli-agent#readme",
  "bugs": {
    "url": "https://github.com/Alan6195/dcm-cli-agent/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\" \"test/e2e/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/*.test.js\"",
    "fixtures": "node tools/make-fixtures.js",
    "bundle": "node tools/build.js bundle",
    "build": "node tools/build.js all",
    "clean": "node tools/build.js clean"
  },
  "keywords": [
    "dicom",
    "dimse",
    "pacs",
    "c-store",
    "c-echo",
    "c-find",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dcmjs": "^0.50.3",
    "dcmjs-dimse": "^0.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}